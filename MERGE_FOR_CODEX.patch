@@ -0,0 +1,16 @@
+<!doctype html>
+<html lang="he" dir="rtl" data-theme="light" data-size="1" data-brand="moh">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>קליטת טפסי התחייבות — המעבדה המרכזית לנגיפים</title>
+<link rel="icon" href="/static/brand/moh-office.png">
+<link rel="stylesheet" href="/static/app.css?v={{v}}">
+  <script type="module" crossorigin src="/app/assets/main-BmrfTHox.js"></script>
+  <link rel="modulepreload" crossorigin href="/app/assets/ButtonBase-DhSR7I7a.js">
