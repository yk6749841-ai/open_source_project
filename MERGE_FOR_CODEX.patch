+  const where = channel === 'gmail' ? 'ב-Gmail' : channel === 'outlook' ? 'ב-Outlook' : 'בוואטסאפ';
+  const target = channel === 'whatsapp'
+    ? (who ? <>צ'אט עם <bdi dir="ltr">{who}</bdi></> : <>וואטסאפ — בחרי שם את איש הקשר</>)
+    : <>מייל אל <bdi dir="ltr">{who}</bdi></>;
+  return <>✓ <b>נפתח {target}</b> {where}, בלשונית חדשה. ההודעה כבר כתובה — עברי ללשונית ולחצי "שליחה".</>;
+}
+function DoneAlt() {
+  const H = S.help;
+  if (H.linkBox) return <input className="halink" readOnly dir="ltr" value={H.linkBox} onClick={(e) => e.currentTarget.select()} />;
+  if (H.doneAlt === 'nomailapp') return <>לא נפתחה תוכנה? כנראה שאין תוכנת מייל מוגדרת במחשב — חזרי ובחרי Gmail או Outlook.</>;
+  // אם הדפדפן חסם את הלשונית — אותו קישור מופיע בחלון, ללחיצה
+  if (H.doneAlt) return <> <a href={H.doneAlt} target="_blank" rel="noopener">לא נפתח? לחצי כאן</a></>;
+  return null;
+}
+
+/* ------------------------------------------------------------ סיור קצר */
+const TOUR = [
+  { art: <>📄 ➜ 📊</>, title: 'גוררים טפסים',
+    text: 'גוררים קבצי PDF או תמונות — כמה שרוצים. כל טופס נקרא לבד ומופיע ברגע שהוא מוכן. ' },
+  { art: <><span className="demo-cell n">939376</span><span className="demo-cell r">00112?344</span><span className="demo-cell g">✓ מאוחדת</span></>,
+    title: 'כתום = לבדוק', text: 'כתום — המנוע לא בטוח או שבדיקה אוטומטית נכשלה, והסיבה כתובה. ירוק — אדם בדק. תא רגיל — לא נמצא ספק.' },
+  { art: <>🔍</>, title: 'מעבר על תא = תקריב',
+    text: 'בטבלה: עכבר או Tab על תא מציגים תקריב של השדה. באריחים: לחיצה פותחת את הטופס — התמונה למעלה, השדות מתחת, וחצים לטופס הבא. ✓ מאשר, ✎ מתקן, ולכל פעולה יש "בטל". הייצוא לאקסל נפתח כשאין יותר שדות לבדיקה.' },
+];
+
+function Tour() {
+  const open = S.modal === 'tour';
+  const s = TOUR[S.tourStep] || TOUR[0];
+  const next = () => { if (S.tourStep < TOUR.length - 1) { S.tourStep += 1; emit(); } else closeTour(); };
+  return (
+    <Dialog open={open} onClose={closeTour}>
+      <div id="tour" className={'tour' + (open ? '' : ' hidden')} role="dialog" aria-modal="true" aria-labelledby="tourTitle"
+        onClick={outside(closeTour)}>
+        <div className="tourbox card">
+          <div className="tourart" id="tourArt" aria-hidden="true">{s.art}</div>
+          <h2 id="tourTitle">{s.title}</h2>
+          <p id="tourText">{s.text}</p>
+          <div className="tourfoot">
+            <span className="tourdots" id="tourDots" aria-hidden="true">{TOUR.map((_, i) => <i key={i} className={i === S.tourStep ? 'on' : undefined}></i>)}</span>
+            <Btn className="secondary" id="tourSkip" onClick={closeTour}>דלג</Btn>
+            <Btn className="primary" id="tourNext" onClick={next}>{S.tourStep === TOUR.length - 1 ? 'מתחילים' : 'הבא'}</Btn>
+          </div>
+        </div>
+      </div>
+    </Dialog>
+  );
+}
diff --git a/frontend/src/components/PageZoom.tsx b/frontend/src/components/PageZoom.tsx
new file mode 100644
index 0000000..3266632
--- /dev/null
+++ b/frontend/src/components/PageZoom.tsx
@@ -0,0 +1,223 @@
+/* הגדלת הטופס על כל המסך: + / −, גרירה, גלגלת, צביטה וסיבוב. העמוד נשמר ב-300 DPI — מקומי, בלי מודל.
+ * pz: w,h = גודל התמונה; W,H = אחרי סיבוב; z = הגדלה; tx,ty = הזזה. אותם חישובים כמו קודם. */
+import { useEffect, useRef, useState } from 'react';
+import Modal from '@mui/material/Modal';
+import { calm, isName } from '../lib';
+import { S, emit, fieldLabel, pageUrl } from '../store';
+import { closePageZoom, focusCard, pzReq, visibleRecords } from '../actions';
+import { Btn } from './Bits';
+import { Boxes } from './FormView';
+
+const PZ_MAX = 8;   // עד פי 8 מ"מתאים למסך"
+
+export function PageZoom() {
+  const open = S.modal === 'pz';
+  const r = open ? pzReq.rec : null;
+  const view = useRef<HTMLDivElement | null>(null);
+  const [viewEl, setViewEl] = useState<HTMLDivElement | null>(null);
+  const pan = useRef<HTMLDivElement>(null);
+  const rot = useRef<HTMLDivElement>(null);
+  const pct = useRef<HTMLSpanElement>(null);
+  const inBtn = useRef<HTMLButtonElement>(null);
+  const outBtn = useRef<HTMLButtonElement>(null);
+  const pz = useRef({ w: 0, h: 0, W: 0, H: 0, deg: 0, z: 1, fit: 1, tx: 0, ty: 0, box: null as number[] | null });
+
+  const P = pz.current;
+  const size = () => ({ w: view.current!.clientWidth, h: view.current!.clientHeight });
+  const layout = () => {
+    const odd = P.deg % 180 !== 0;
+    P.W = odd ? P.h : P.w;
+    P.H = odd ? P.w : P.h;
+    Object.assign(pan.current!.style, { width: P.W + 'px', height: P.H + 'px' });
+    Object.assign(rot.current!.style, { width: P.w + 'px', height: P.h + 'px', left: (P.W - P.w) / 2 + 'px',
+      top: (P.H - P.h) / 2 + 'px', transform: P.deg ? 'rotate(' + P.deg + 'deg)' : '' });
+  };
+  // לא נותנים לעמוד לברוח מהמסך: קטן מהמסך ← באמצע; גדול ← הקצוות לא נכנסים פנימה
+  const clamp = () => {
+    const v = size(), cw = P.W * P.z, ch = P.H * P.z;
+    P.tx = cw <= v.w ? (v.w - cw) / 2 : Math.min(0, Math.max(v.w - cw, P.tx));
+    P.ty = ch <= v.h ? (v.h - ch) / 2 : Math.min(0, Math.max(v.h - ch, P.ty));
+  };
+  const apply = (animate: boolean) => {
+    clamp();
+    const el = pan.current!;
+    el.classList.toggle('anim', !!animate && !calm);
+    el.style.transform = 'translate(' + P.tx + 'px,' + P.ty + 'px) scale(' + P.z + ')';
+    el.style.setProperty('--z', String(P.z));
+    pct.current!.textContent = Math.round(P.z / P.fit * 100) + '%';
+    outBtn.current!.disabled = P.z <= P.fit * 1.001;
+    inBtn.current!.disabled = P.z >= P.fit * PZ_MAX * 0.999;
+  };
+  const fit = (animate: boolean) => {
+    const v = size();
+    P.fit = Math.min(v.w / P.W, v.h / P.H) * 0.96;
+    P.z = P.fit;
+    apply(animate);
+  };
+  const zoomAt = (factor: number, x: number | null, y: number | null, animate: boolean) => {
+    const v = size();
+    if (x == null || y == null) { x = v.w / 2; y = v.h / 2; }
+    const nz = Math.max(P.fit, Math.min(P.fit * PZ_MAX, P.z * factor));
+    const px = (x - P.tx) / P.z, py = (y - P.ty) / P.z;
+    P.tx = x - px * nz;
+    P.ty = y - py * nz;
+    P.z = nz;
+    apply(animate);
+  };
+  // "לשדה המסומן": מגדילים כך שהמלבן הכתום ממלא בערך את רוב המסך, ובמרכזו
+  const focusBox = () => {
+    const b = P.box;
+    if (!b) return;
+    const rad = P.deg * Math.PI / 180, cos = Math.cos(rad), sin = Math.sin(rad);
+    const x = ((b[0] + b[2]) / 2 - 0.5) * P.w, y = ((b[1] + b[3]) / 2 - 0.5) * P.h;
+    const cx = P.W / 2 + x * cos - y * sin, cy = P.H / 2 + x * sin + y * cos;
+    const odd = P.deg % 180 !== 0;
+    const bw = (odd ? b[3] - b[1] : b[2] - b[0]) * (odd ? P.h : P.w);
+    const bh = (odd ? b[2] - b[0] : b[3] - b[1]) * (odd ? P.w : P.h);
+    const v = size();
+    P.z = Math.max(P.fit, Math.min(P.fit * 5, v.w * 0.45 / Math.max(bw, 1), v.h * 0.35 / Math.max(bh, 1)));
+    P.tx = v.w / 2 - cx * P.z;
+    P.ty = v.h / 2 - cy * P.z;
+    apply(true);
+  };
+
+  // פתיחה: התמונה נטענת, ואז "מתאים למסך"
+  useEffect(() => {
+    if (!open || !r) return;
+    P.deg = S.viewTurn[r.record_id] || 0;
+    P.box = focusBoxOf();
+    view.current?.focus({ preventScroll: true });
+    const img = rot.current!.querySelector('img')!;
+    const ready = () => { P.w = img.naturalWidth || 1; P.h = img.naturalHeight || 1; layout(); fit(false); };
+    if (img.complete && img.naturalWidth) ready(); else img.addEventListener('load', ready, { once: true });
+  }, [open, r]);
+
+  // גרירה, גלגלת, לחיצה כפולה, צביטה; שינוי גודל החלון
+  useEffect(() => {
+    const el = viewEl;
+    if (!el) return;
+    const pointers: Record<number, { x: number; y: number }> = {};
+    let prev: { x: number; y: number } | null = null, pinch = 0;
+    const local = (e: { clientX: number; clientY: number }) => { const b = el.getBoundingClientRect(); return { x: e.clientX - b.left, y: e.clientY - b.top }; };
+    const wheel = (e: WheelEvent) => { e.preventDefault(); const p = local(e); zoomAt(Math.exp(-e.deltaY * 0.0015), p.x, p.y, false); };
+    const dbl = (e: MouseEvent) => { const p = local(e); zoomAt(2, p.x, p.y, true); };
+    const down = (e: PointerEvent) => {
+      if (e.button !== 0) return;
+      el.setPointerCapture(e.pointerId);
+      pointers[e.pointerId] = local(e);
+      prev = local(e);
+      pinch = 0;
+      el.classList.add('drag');
+    };
+    const move = (e: PointerEvent) => {
+      if (!pointers[e.pointerId]) return;
+      pointers[e.pointerId] = local(e);
+      const ids = Object.keys(pointers);
+      if (ids.length >= 2) {                     // צביטה בשתי אצבעות
+        const a = pointers[+ids[0]], b = pointers[+ids[1]];
+        const d = Math.hypot(a.x - b.x, a.y - b.y);
+        if (pinch) zoomAt(d / pinch, (a.x + b.x) / 2, (a.y + b.y) / 2, false);
+        pinch = d;
+        return;
+      }
+      const p = pointers[e.pointerId];
+      P.tx += p.x - prev!.x;
+      P.ty += p.y - prev!.y;
+      prev = p;
+      apply(false);
+    };
+    const up = (e: PointerEvent) => {
+      delete pointers[e.pointerId];
+      const ids = Object.keys(pointers);
+      pinch = 0;
+      if (ids.length) prev = pointers[+ids[0]]; else el.classList.remove('drag');
+    };
+    const resize = () => {
+      if (S.modal !== 'pz' || !P.w) return;
+      const ratio = P.z / P.fit, v = size();
+      P.fit = Math.min(v.w / P.W, v.h / P.H) * 0.96;
+      P.z = P.fit * ratio;
+      apply(false);
+    };
+    el.addEventListener('wheel', wheel, { passive: false });
+    el.addEventListener('dblclick', dbl);
+    el.addEventListener('pointerdown', down);
+    el.addEventListener('pointermove', move);
+    el.addEventListener('pointerup', up);
+    el.addEventListener('pointercancel', up);
+    window.addEventListener('resize', resize);
+    return () => {
+      el.removeEventListener('wheel', wheel);
+      el.removeEventListener('dblclick', dbl);
+      el.removeEventListener('pointerdown', down);
+      el.removeEventListener('pointermove', move);
+      el.removeEventListener('pointerup', up);
+      el.removeEventListener('pointercancel', up);
+      window.removeEventListener('resize', resize);
+    };
+  }, [viewEl]);
+
+  // בתוך ההגדלה: + / − / 0, חיצים מזיזים (Esc — דרך ה-Modal)
+  const keys = (e: React.KeyboardEvent) => {
+    const step = 90;
+    if (e.key === '+' || e.key === '=') { e.preventDefault(); return zoomAt(1.25, null, null, true); }
+    if (e.key === '-' || e.key === '_') { e.preventDefault(); return zoomAt(1 / 1.25, null, null, true); }
+    if (e.key === '0') { e.preventDefault(); return fit(true); }
+    const moves: Record<string, number[]> = { ArrowLeft: [step, 0], ArrowRight: [-step, 0], ArrowUp: [0, step], ArrowDown: [0, -step] };
+    if (moves[e.key] && !(e.target as HTMLElement).closest('button')) {
+      e.preventDefault();
+      P.tx += moves[e.key][0];
+      P.ty += moves[e.key][1];
+      apply(true);
+    }
+  };
+  const turn = () => {
+    if (!r) return;
+    P.deg = (P.deg + 90) % 360;
+    S.viewTurn[r.record_id] = P.deg;   // גם הטופס הקטן והתקריב מסתובבים יחד
+    if (S.view === 'form') focusCard(S.cardIndex, true);
+    emit();
+    layout();
+    fit(false);
+  };
+
+  const list = r ? visibleRecords() : [];
+  const key = pzReq.key;
+  const box = r ? focusBoxOf() : null;
+  return (
+    <Modal open={open} onClose={closePageZoom} keepMounted disablePortal disableAutoFocus disableRestoreFocus disableScrollLock hideBackdrop>
+      <div id="pgZoom" className={'pzmodal' + (open ? '' : ' hidden')} role="dialog" aria-modal="true" aria-labelledby="pzTitle" onKeyDown={keys}>
+        <div className="pzbar">
+          <strong id="pzTitle">{r ? 'טופס ' + (list.indexOf(r) + 1) + ' / ' + list.length + ' · ' + (isName(key) ? 'שם פרטי ושם משפחה' : fieldLabel(key)) : 'הגדלת הטופס'}</strong>
+          <span className="grow"></span>
+          <div className="pzgroup" role="group" aria-label="הגדלה">
+            <Btn className="pzbtn" id="pzOut" aria-label="הקטנה" title="הקטנה (−)" ref={outBtn} onClick={() => zoomAt(1 / 1.25, null, null, true)}>−</Btn>
+            <span className="pzpct" id="pzPct" aria-live="polite" ref={pct}>100%</span>
+            <Btn className="pzbtn" id="pzIn" aria-label="הגדלה" title="הגדלה (+)" ref={inBtn} onClick={() => zoomAt(1.25, null, null, true)}>+</Btn>
+          </div>
+          <Btn className="pzwide" id="pzFit" title="התאמה למסך (0)" onClick={() => fit(true)}>התאמה למסך</Btn>
+          <Btn className={'pzwide' + (box ? '' : ' hidden')} id="pzBox" title="הגדלת האזור המסומן בכתום" onClick={focusBox}>לשדה המסומן</Btn>
+          <Btn className="pzbtn" id="pzTurn" aria-label="סיבוב" title="סיבוב" onClick={turn}>↻</Btn>
+          <Btn className="pzbtn" id="pzClose" aria-label="סגירת ההגדלה" title="סגירה (Esc)" onClick={closePageZoom}>✕</Btn>
+        </div>
+        <div className="pzview" id="pzView" tabIndex={0} aria-label="העמוד המוגדל — גררו כדי לזוז, גלגלת או +/− להגדלה"
+          ref={(el) => { view.current = el; if (el !== viewEl) setViewEl(el); }}>
+          <div className="pzpan" id="pzPan" ref={pan}><div className="pzrot" id="pzRot" ref={rot}>
+            {r ? <><img alt={'עמוד ' + r.page_number + ' של ' + r.source_name + ', מוגדל'} src={pageUrl(r)} /><Boxes r={r} fieldKey={key} /></> : null}
+          </div></div>
+        </div>
+        <p className="pzhint">גררו כדי לזוז · גלגלת או לחיצה כפולה להגדלה · Esc לסגירה</p>
+      </div>
+    </Modal>
+  );
+}
+
+// התיבה שאליה "לשדה המסומן" מגדיל: השדה, או שני השמות יחד כשהם באותו אזור
+function focusBoxOf(): number[] | null {
+  const r = pzReq.rec;
+  if (!r) return null;
+  const f = r.fields[pzReq.key];
+  if (!isName(pzReq.key) || !r.full_name_crop) return f && f.crop_box;
+  const a = r.fields.first_name.crop_box!, b = r.fields.last_name.crop_box!;
+  return [Math.min(a[0], b[0]), Math.min(a[1], b[1]), Math.max(a[2], b[2]), Math.max(a[3], b[3])];
+}
diff --git a/frontend/src/components/Pop.tsx b/frontend/src/components/Pop.tsx
new file mode 100644
index 0000000..01bcfed
--- /dev/null
+++ b/frontend/src/components/Pop.tsx
@@ -0,0 +1,117 @@
+/* תקריב צף על תא בטבלה, ו"טופס N" — הטופס עצמו צף בצד התא. המיקום נמדד אחרי הציור, כמו קודם. */
+import { useLayoutEffect, useRef } from 'react';
+import { NAME_KEYS, canApprove, canAskHelp, isName, perValue, whyOf } from '../lib';
+import type { Rec } from '../lib';
+import { S, cropUrl, emit, fieldLabel, pageUrl, recordById } from '../store';
+import { approveField, cancelPopTimer, closePop, helpAction, openPageZoom, openRecord, scheduleClose, startEdit } from '../actions';
+import { Btn, StatusBadge, ValueView } from './Bits';
+import { HelpStrip } from './FormView';
+
+function anchor(): HTMLElement | null {
+  const p = S.pop;
+  if (!p) return null;
+  return document.querySelector(p.kind === 'page' ? 'td.formcol[data-rec="' + p.rec + '"]'
+    : 'td.cell[data-rec="' + p.rec + '"][data-key="' + p.key + '"]');
+}
+
+export function Pop() {
+  const el = useRef<HTMLDivElement>(null);
+  const p = S.pop;
+  const r = p ? recordById(p.rec) : null;
+
+  const place = () => {
+    const pop = el.current, td = anchor();
+    if (!pop || !td || !S.pop) return;
+    const cellBox = td.getBoundingClientRect();
+    const w = pop.offsetWidth, h = pop.offsetHeight;
+    if (S.pop.kind === 'page') {
+      // משמאל לתא (העמודה הימנית בטבלה), בגובה התא ובתוך גבולות המסך; החץ מצביע על התא
+      let left = cellBox.left - w - 12;
+      if (left < 10) left = Math.min(cellBox.right + 12, window.innerWidth - w - 10);
+      const middle = cellBox.top + cellBox.height / 2;
+      const top = Math.max(10, Math.min(middle - 40, window.innerHeight - h - 10));
+      pop.style.left = (left + window.scrollX) + 'px';
+      pop.style.top = (top + window.scrollY) + 'px';
+      pop.style.setProperty('--arrow-y', Math.max(18, Math.min(h - 18, middle - top)) + 'px');
+      return;
+    }
+    const below = cellBox.top < h + 90;
+    let left = cellBox.left + cellBox.width / 2 - w / 2;
+    left = Math.max(10, Math.min(left, window.innerWidth - w - 10));
+    const top = below ? cellBox.bottom + 10 : cellBox.top - h - 10;
+    pop.classList.toggle('below', below);
+    pop.style.left = (left + window.scrollX) + 'px';
+    pop.style.top = (top + window.scrollY) + 'px';
+    pop.style.setProperty('--arrow', Math.max(14, Math.min(w - 14, cellBox.left + cellBox.width / 2 - left)) + 'px');
+  };
+  useLayoutEffect(() => { if (S.pop && !anchor()) { S.pop = null; emit(); return; } place(); });
+
+  const cls = 'pop' + (!p || !r ? ' hidden' : '') + (p && p.kind === 'page' ? ' pagepop' : '');
+  return (
+    <div id="pop" className={cls} role="dialog" aria-label="תקריב השדה" ref={el}
+      onMouseEnter={cancelPopTimer} onMouseLeave={scheduleClose}
+      onClick={(e) => {
+        // כפתורי בקשת העזרה בתוך התקריב (שליחה שוב / ביטול / להשתמש בערך)
+        const h = (e.target as HTMLElement).closest('[data-help]') as HTMLElement | null;
+        if (h && p && r) { closePop(); helpAction(h.dataset.help!, r, p.key, null); }
+      }}>
+      {p && r ? (p.kind === 'page' ? <PageContent r={r} onLoad={place} /> : <CellContent r={r} fieldKey={p.key} onLoad={place} />) : null}
+    </div>
+  );
+}
+
+// "טופס N" בטבלה: הטופס עצמו — גדול מהתקריב, עם הגדלה ופתיחה
+function PageContent({ r, onLoad }: { r: Rec; onLoad: () => void }) {
+  const num = S.last!.records.indexOf(r) + 1;
+  const zoom = () => { const td = anchor(); closePop(); openPageZoom(td, r, S.fields[0].key); };
+  return <>
+    <div className="phead"><strong>טופס {num}</strong><StatusBadge r={r} /></div>
+    <div className="pmeta" title={r.source_name}>עמוד {r.page_number} · <bdi>{r.source_name}</bdi></div>
+    <div className="ppage" data-act-zoom="1" title="לחצו להגדלה" onClick={zoom}>
+      <img alt={'טופס ' + num + ' — עמוד ' + r.page_number + ' של ' + r.source_name} src={pageUrl(r)} onLoad={onLoad} /></div>
+    <div className="btns"><Btn className="secondary" data-act="zoom" onClick={zoom}>🔍 הגדלה</Btn>
+      <Btn className="primary" data-act="open" onClick={() => { closePop(); openRecord(r.record_id); }}>פתיחת הטופס</Btn></div>
+  </>;
+}
+
+function CellContent({ r, fieldKey, onLoad }: { r: Rec; fieldKey: string; onLoad: () => void }) {
+  const f = r.fields[fieldKey];
+  const state = f.state === 'needs_review' ? '⚠ לבדיקה' : f.state === 'approved' ? '✓ אושר' : '';
+  const why = whyOf(f);
+  const many = perValue(f);
+  let crops;
+  if (isName(fieldKey)) crops = <NameCrops r={r} onLoad={onLoad} />;
+  else if (many) crops = many.map((b, i) => (b ? <div key={i} className="crop multi"><span className="cv"><bdi>{f.values[i]}</bdi></span>
+    <img alt={'תקריב של ' + f.values[i]} src={cropUrl(r, fieldKey, i)} onLoad={onLoad} /></div> : null));
+  else crops = f.crop_box
+    ? <div className="crop"><img alt={'תקריב של ' + fieldLabel(fieldKey)} src={cropUrl(r, fieldKey)} onLoad={onLoad} /></div>
+    : <div className="crop"><div className="nocrop">אין מיקום לשדה הזה — אפשר לפתוח את הטופס המלא</div></div>;
+  return (
+    <>
+      <div className="lbl"><span>{isName(fieldKey) ? 'שם פרטי ושם משפחה' : fieldLabel(fieldKey)}</span><span>{state}</span></div>
+      {crops}
+      {isName(fieldKey) ? NAME_KEYS.map((k) => (
+        <div key={k} className={'val nm' + (k === fieldKey ? ' now' : '')}><span>{fieldLabel(k)}:</span> <ValueView f={r.fields[k]} /></div>
+      )) : <div className="val"><ValueView f={f} /></div>}
+      {why ? <div className="why">{why}</div> : null}
+      <HelpStrip f={f} fieldKey={fieldKey} />
+      <div className="btns"><Btn className="secondary" data-act="open" onClick={() => { closePop(); openRecord(r.record_id); }}>פתיחת הטופס</Btn>
+        {!S.processing && canAskHelp(r, f) ? <Btn className="secondary" data-act="help" onClick={() => { closePop(); helpAction('ask', r, fieldKey, null); }}>🙋 עזרה</Btn> : null}
+        {canApprove(f) ? <Btn className="primary" data-act="approve" onClick={() => approveField(r.record_id, fieldKey)}>✓ {f.values.length ? 'אשר' : 'אשר כריק'}</Btn> : null}
+        <Btn data-act="edit" onClick={() => { closePop(); startEdit('cell', r.record_id, fieldKey); }}>✎ תקן</Btn></div>
+    </>
+  );
+}
+
+// בטבלה, על תא שם פרטי או שם משפחה: תקריב אחד של שני השמות יחד (כמו במצב טופס)
+function NameCrops({ r, onLoad }: { r: Rec; onLoad: () => void }) {
+  const img = (k: string, label: string) => <div className="crop"><img alt={'תקריב של ' + label} src={cropUrl(r, k)} onLoad={onLoad} /></div>;
+  if (r.full_name_crop) return img('full_name', 'שם פרטי ושם משפחה');
+  const a = r.fields.first_name.crop_box, b = r.fields.last_name.crop_box;
+  if (a && b && a.join() === b.join()) return img('first_name', 'שם פרטי ושם משפחה');
+  const parts = NAME_KEYS.filter((k) => r.fields[k].crop_box);
+  return parts.length ? <>{parts.map((k) => (
+    <div key={k} className="crop multi"><span className="cv">{fieldLabel(k)}</span>
+      <img alt={'תקריב של ' + fieldLabel(k)} src={cropUrl(r, k)} onLoad={onLoad} /></div>))}</>
+    : <div className="crop"><div className="nocrop">אין מיקום לשם — אפשר לפתוח את הטופס המלא</div></div>;
+}
