+
+function Skeleton() {
+  return <>{Array.from({ length: 4 }, (_, i) => (
+    <tr key={i} className="skel">{Array.from({ length: 9 }, (_, j) => <td key={j}><span></span></td>)}<td></td></tr>
+  ))}</>;
+}
+
+function ApprovedRows({ rows }: { rows: any[] }) {
+  let previous = '';
